                "player"
              ]
            },
            "description": "Token olmadan hicbir korumali uc noktaya erisim yok. Spring Security istegi controller'a hic ulastirmadan reddediyor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
