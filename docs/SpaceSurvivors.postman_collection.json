        {
          "name": "401  sahte token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{forgedToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/player",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "player"
              ]
            },
            "description": "Imzasi bozulmus token. Sunucu imzayi dogruladigi icin fark ediyor."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gecerli bir token'in imzasinin son karakterini degistir. Icerigi hala",
                  "// kusursuz \u2014 eski Device header'inin ASLA yakalayamayacagi sey buydu.",
                  "const t = pm.collectionVariables.get('tokenA');",
                  "pm.collectionVariables.set('forgedToken', t.slice(0, -1) + (t.slice(-1) === 'A' ? 'B' : 'A'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
