              "path": [
                "v1",
                "progress"
              ]
            },
            "description": "version:0 = 'elimde sunucudan gelmis bir surum yok, bu ilk yuklemem'.\n\nDonen surum 0, cunku Hibernate'in @Version'i sifirdan basliyor. Sayi istemci icin anlamsiz \u2014 sadece geri yollamasi gereken bir jeton.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progress\": {\n    \"schemaVersion\": 5,\n    \"wallet\": 100,\n    \"ownedShipIds\": [\n      \"scout\"\n    ]\n  },\n  \"version\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
