            ],
            "url": {
              "raw": "{{baseUrl}}/v1/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "progress"
              ]
            },
            "description": "version:5 gibi yanlis bir surum yolluyoruz, sunucu 0'da. Optimistic locking devrede: UPDATE ... WHERE version = 5 hicbir satira uymuyor, 0 satir etkileniyor.\n\nSunucu koru korune ezmek yerine kendi kopyasini geri veriyor. wallet:999 YAZILMADI. Bu olmasaydi: telefonda kazandigin scrap, tablette eski profil kaydedilince ucardi.\n\nBeklenen: 409 {\"serverVersion\":0,\"progress\":{...}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progress\": {\n    \"wallet\": 999\n  },\n  \"version\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PUT /v1/progress  (dogru surum)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "progress"
              ]
            },
            "description": "Artik elindeki surum dogru. Yazildi, surum 1 oldu.\n\nBeklenen: 200 {\"version\":1}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progress\": {\n    \"schemaVersion\": 5,\n    \"wallet\": 250\n  },\n  \"version\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
