    {
      "name": "6 - Hata senaryolari",
      "item": [
        {
          "name": "401 - token yok",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/player",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "player"
              ]
            },
            "description": "Token olmadan hicbir uc noktaya erisim yok. Spring Security istegi controller'a hic ulastirmadan reddediyor.\n\nBeklenen: 401"
          }
        },
        {
          "name": "400 - isim cok kisa",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
