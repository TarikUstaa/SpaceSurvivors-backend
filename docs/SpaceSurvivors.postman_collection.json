            "url": {
              "raw": "{{baseUrl}}/v1/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "progress"
              ]
            },
            "description": "Profil var ama ilerleme kaydi yok. 404, 'bos profil'den farkli bir sey soyluyor: istemci bunu gorunce kendi local kaydini yukluyor.\n\nBeklenen: 404 {\"detail\":\"no progress stored yet\"}"
          }
        }
      ]
    },
    {
      "name": "3 - Bulut kayit",
      "item": [
        {
          "name": "PUT /v1/progress  (ilk kayit)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "progress"
              ]
            },
            "description": "version:0 = 'elimde sunucudan gelmis bir surum yok, bu ilk yuklemem'.\n\nBeklenen: 200 {\"version\":0}\n\nSifirdan basliyor cunku Hibernate'in @Version'i oyle. Sayi istemci icin anlamsiz \u2014 sadece geri yollamasi gereken bir jeton.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progress\": {\n    \"schemaVersion\": 5,\n    \"wallet\": 100,\n    \"ownedShipIds\": [\n      \"scout\"\n    ]\n  },\n  \"version\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /v1/progress  (geri oku)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
